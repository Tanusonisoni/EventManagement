#!/usr/bin/env node

import http from "http";
import debuger from "debug";
import app from "../app.js";
import dotenv from 'dotenv';
import connectDb from "../config/db.js";
import { transporter } from "../config/mailTransporter.js";
import { createServer } from "http";
import { Server } from "socket.io";
const debug=debuger('event-management:server')
import { verifyToken } from "../config/jwt.js";

dotenv.config();

// const debug = debugLib("eventmanagemant:server");

const port = normalizePort(process.env.PORT || "3000");
app.set("port", port);

const server = http.createServer(app);

//CREATE SOCKET.IO SERVER
const io=new Server(server,{
  cors:{
    origin:"*",
    methods:["GET","POST"]
  }
})

io.use((socket,next)=>{
  const token=socket.handelShake.headers.authprization?.split(' ')[1];
  if(token){
    let tokenData=verifyToken(token);
    if(!tokenData.role !=="admin"){
      return next(new Error("Authentication error"));
    }
    next();
  }else {
    next(new Error("Authentication error"));
  }
})

app.set("io",io);
io.on("connection",(socket)=>{
  console.log("A user connected"+socket.id);

socket.emit("welcome", {
    message: "Welcome to the socket.io server!",
    socketId: socket.id
  });

  socket.on("joinRoom", (eventId) => {
    // Assuming you have a way to determine the room name from the event ID
    const room = `event_${eventId}`;
    socket.join(room);
    console.log(`Socket ${socket.id} joined room ${room}`);
  });

  socket.on("leaveRoom", (eventId) => {
    const room = `event_${eventId}`;
    socket.leave(room);
    console.log(`Socket ${socket.id} left room ${room}`);
  });

  socket.on("disconnect", () => {
    console.log("A user disconnected");
  });
});
  /** normalization a port into a number , string or false */
// Connect Database
await connectDb();

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) {
    return val;
  }

  if (port >= 0) {
    return port;
  }

  return false;
}

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  const bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

  switch (error.code) {
    case "EACCES":
      console.error(bind + " requires elevated privileges");
      process.exit(1);
      break;

    case "EADDRINUSE":
      console.error(bind + " is already in use");
      process.exit(1);
      break;

    default:
      throw error;
  }
}

async function onListening() {
  const addr = server.address();
  const bind = typeof addr === "string" ? "pipe " + addr :
  "http://localhost:" + addr.port;
  debug("Listening on " + bind);

  try{
    await connectDb();
    let res=await transporter.verify();
    console.log(res);
  }catch(err)
  {
    console.log("error connecting to db",err)
  }
}